// Confirma a adição/edição do produto
function confirmarAdicao() {
  const produto = {
    nome: document.getElementById("modalNome").value,
    estoqueAnteriorCx: document.getElementById("modalEstCx").value,
    estoqueAnteriorUn: document.getElementById("modalEstUn").value,
    entradasCx: document.getElementById("modalEntCx").value,
    entradasUn: document.getElementById("modalEntUn").value,
    finalCx: document.getElementById("modalFimCx").value,
    finalUn: document.getElementById("modalFimUn").value,
    unidadesPorCaixa: document.getElementById("modalUnCaixa").value,
    precoUnitario: document.getElementById("modalPreco").value
  };
  
  if (!produto.nome) {
    alert("Por favor, informe o nome do produto!");
    return;
  }
  
  if (linhaEditando) {
    linhaEditando.cells[0].firstChild.value = produto.nome;
    linhaEditando.cells[1].firstChild.value = produto.estoqueAnteriorCx;
    linhaEditando.cells[2].firstChild.value = produto.estoqueAnteriorUn;
    linhaEditando.cells[3].firstChild.value = produto.entradasCx;
    linhaEditando.cells[4].firstChild.value = produto.entradasUn;
    linhaEditando.cells[5].firstChild.value = produto.finalCx;
    linhaEditando.cells[6].firstChild.value = produto.finalUn;
    linhaEditando.cells[7].firstChild.value = produto.unidadesPorCaixa;
    linhaEditando.cells[8].firstChild.value = produto.precoUnitario;
    
    linhaEditando = null;
  } else {
    adicionarProduto(produto);
  }
  
  fecharModal('modalAdicionar');
