// Salva o estado atual no histórico
function salvarEstado() {
  const produtos = [];
  document.querySelectorAll("#tabelaProdutos tr").forEach(linha => {
    const produto = {
      nome: linha.cells[0].firstChild.value,
      estoqueAnteriorCx: linha.cells[1].firstChild.value,
      estoqueAnteriorUn: linha.cells[2].firstChild.value,
      entradasCx: linha.cells[3].firstChild.value,
      entradasUn: linha.cells[4].firstChild.value,
      finalCx: linha.cells[5].firstChild.value,
      finalUn: linha.cells[6].firstChild.value,
      unidadesPorCaixa: linha.cells[7].firstChild.value,
      precoUnitario: linha.cells[8].firstChild.value
    };
    produtos.push(produto);
  });
  
  if (historicoAcoes.length > 10) {
    historicoAcoes.shift();
  }
  
  historicoAcoes.push(JSON.stringify(produtos));
  estadoAtual = produtos;
  
  // Salva os dados persistentes
  salvarDadosPersistentes();
  
  // Agenda o salvamento automático
  agendarSalvamentoAutomatico();
  
  // Agenda o cálculo automático
  agendarCalculoAutomatico();
}

// Agenda o salvamento automático
function agendarSalvamentoAutomatico() {
  if (autoSaveTimeout) {
    clearTimeout(autoSaveTimeout);
  }
  
  autoSaveTimeout = setTimeout(() => {
    salvarDadosAutomaticamente();
  }, 2000); // 2 segundos após a última alteração
}

// Agenda o cálculo automático
function agendarCalculoAutomatico() {
  if (calcularTimeout) {
    clearTimeout(calcularTimeout);
  }
  
  calcularTimeout = setTimeout(() => {
    calcular();
  }, 500); // 0.5 segundos após a última alteração
}

// Salva dados automaticamente
function salvarDadosAutomaticamente() {
  const data = document.getElementById("dataContagem").value;
  if (!data) return;

  const linhas = document.querySelectorAll("#tabelaProdutos tr");
  const produtos = [];

  linhas.forEach(linha => {
    const nome = linha.cells[0].firstChild.value;
    const info = {
      nome,
      estoqueAnteriorCx: +linha.cells[1].firstChild.value || 0,
      estoqueAnteriorUn: +linha.cells[2].firstChild.value || 0,
      entradasCx: +linha.cells[3].firstChild.value || 0,
      entradasUn: +linha.cells[4].firstChild.value || 0,
      finalCx: +linha.cells[5].firstChild.value || 0,
      finalUn: +linha.cells[6].firstChild.value || 0,
      unidadesPorCaixa: +linha.cells[7].firstChild.value || 1,
      precoUnitario: +linha.cells[8].firstChild.value || 0
    };
    produtos.push(info);
    infoFixas[nome] = {
      unidadesPorCaixa: info.unidadesPorCaixa,
      precoUnitario: info.precoUnitario
    };
  });

  localStorage.setItem("inventario-" + data, JSON.stringify(produtos));
  localStorage.setItem("infoFixas", JSON.stringify(infoFixas));
  atualizarSelectDatas();
  
  console.log("Dados salvos automaticamente");
}

// Desfaz a última ação
function desfazerAcao() {
  toggleMenu();
  if (historicoAcoes.length > 1) {
    historicoAcoes.pop();
    const estadoAnterior = JSON.parse(historicoAcoes[historicoAcoes.length - 1]);
    
    document.getElementById("tabelaProdutos").innerHTML = "";
    estadoAnterior.forEach(p => adicionarProduto(p));
    
    salvarEstado();
  } else {
    alert("Não há ações para desfazer!");
  }
}

// Função para editar cabeçalhos
function editarCabecalho(elemento) {
  const textoOriginal = elemento.textContent;
  const input = document.createElement('input');
  input.type = 'text';
  input.value = textoOriginal;
  input.style.width = '100%';
  input.style.textAlign = 'center';
  input.style.fontWeight = '600';
  
  elemento.innerHTML = '';
  elemento.appendChild(input);
  input.focus();
  
  input.addEventListener('blur', function() {
    elemento.textContent = input.value || textoOriginal;
    salvarCabecalhos();
  });
  
  input.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      elemento.textContent = input.value || textoOriginal;
      salvarCabecalhos();
    }
  });
}

// Função para salvar cabeçalhos
function salvarCabecalhos() {
  const cabecalhos = [];
  document.querySelectorAll('#tabelaInventario th').forEach(th => {
    cabecalhos.push(th.textContent);
  });
  localStorage.setItem('cabecalhos', JSON.stringify(cabecalhos));
}

// Cria inputs na tabela
function criarInput(tipo, valor = "", step = "1", isCxUn = false, isPreco = false, isProduto = false) {
  const input = document.createElement("input");
  input.type = tipo;
  input.value = valor;
  input.step = step;
  
  if (isProduto) {
    input.className = "input-cell produto";
    input.style.textAlign = "left";
    input.style.minWidth = "180px";
  } else if (isCxUn) {
    input.className = "input-cell cx-un";
    input.maxLength = 5;
    input.min = "0";
    input.max = "99999";
    input.style.width = "100px";
  } else if (isPreco) {
    input.className = "input-cell preco";
    input.maxLength = 8;
    input.min = "0";
    input.step = "0.01";
    input.style.width = "120px";
  } else {
    input.className = "input-cell";
    input.style.width = "100px";
  }
  
  input.style.fontWeight = "600";
  input.style.padding = "8px";
  
  // Novo tratamento de eventos de clique
  let clickTimeout;
  
  const handleClick = function(e) {
    const linha = this.parentElement.parentElement;
    
    clearTimeout(clickTimeout);
    
    if (e.detail === 1) {
      clickTimeout = setTimeout(() => {
        // Clique único
        if ((isProduto || (isCxUn && (this.parentElement.cellIndex === 5 || this.parentElement.cellIndex === 6)))) {
          abrirModalContagemFinal(linha);
        }
      }, 300);
    } else if (e.detail === 2) {
      // Duplo clique - cancela o clique único
      clearTimeout(clickTimeout);
      abrirModalAdicionar(linha);
    }
  };
  
  input.addEventListener('click', handleClick);
  
  // Configura o salvamento automático quando o valor muda
  input.addEventListener('change', () => {
    salvarEstado();
  });
  
  // Configura o cálculo automático quando o valor muda
  input.addEventListener('input', () => {
    agendarCalculoAutomatico();
  });
  
  // Limpa o timeout quando o input perde o foco
  input.addEventListener('blur', () => {
    clearTimeout(clickTimeout);
  });
  
  return input;
}

// Adiciona novo produto à tabela
function adicionarProduto(produto = {}) {
  salvarEstado();
  
  const tabela = document.getElementById("tabelaProdutos");
  const linha = document.createElement("tr");

  const nomeInput = criarInput("text", produto.nome || "", "1", false, false, true);
  nomeInput.onchange = () => preencherFixos(linha, nomeInput.value);

  const estCx = criarInput("number", produto.estoqueAnteriorCx || "", "1", true);
  const estUn = criarInput("number", produto.estoqueAnteriorUn || "", "1", true);
  const entCx = criarInput("number", produto.entradasCx || "", "1", true);
  const entUn = criarInput("number", produto.entradasUn || "", "1", true);
  const fimCx = criarInput("number", produto.finalCx || "", "1", true);
  const fimUn = criarInput("number", produto.finalUn || "", "1", true);
  const unidadesCaixa = criarInput("number", produto.unidadesPorCaixa || "1", true);
  const precoUn = criarInput("number", produto.precoUnitario || "0", "0.01", false, true);

  const criarCelula = (elemento) => {
    const td = document.createElement("td");
    td.appendChild(elemento);
    return td;
  };

  linha.appendChild(criarCelula(nomeInput));
  linha.appendChild(criarCelula(estCx));
  linha.appendChild(criarCelula(estUn));
  linha.appendChild(criarCelula(entCx));
  linha.appendChild(criarCelula(entUn));
  linha.appendChild(criarCelula(fimCx));
  linha.appendChild(criarCelula(fimUn));
  linha.appendChild(criarCelula(unidadesCaixa));
  linha.appendChild(criarCelula(precoUn));

  tabela.appendChild(linha);
  
  // Dispara cálculo automático após adicionar produto
  agendarCalculoAutomatico();
}

// Preenche valores fixos
function preencherFixos(linha, nome) {
  const info = infoFixas[nome];
  if (info) {
    linha.cells[7].firstChild.value = info.unidadesPorCaixa;
    linha.cells[8].firstChild.value = info.precoUnitario;
    agendarCalculoAutomatico();
  }
}

// Cálculo principal
function calcular() {
  const linhas = document.querySelectorAll("#tabelaProdutos tr");
  const vendas = [];
  let totalGeral = 0;

  linhas.forEach(linha => {
    const nome = linha.cells[0].firstChild.value;
    const estCx = +linha.cells[1].firstChild.value || 0;
    const estUn = +linha.cells[2].firstChild.value || 0;
    const entCx = +linha.cells[3].firstChild.value || 0;
    const entUn = +linha.cells[4].firstChild.value || 0;
    const fimCx = +linha.cells[5].firstChild.value || 0;
    const fimUn = +linha.cells[6].firstChild.value || 0;
    const unPorCaixa = +linha.cells[7].firstChild.value || 1;
    const precoUn = +linha.cells[8].firstChild.value || 0;

    const totalInicial = (estCx + entCx) * unPorCaixa + estUn + entUn;
    const totalFinal = fimCx * unPorCaixa + fimUn;
    const vendidos = totalInicial - totalFinal;
    const totalVendido = vendidos * precoUn;

    totalGeral += totalVendido;
    vendas.push({ nome, vendidos, totalVendido });
  });

  let resultadoHTML = "<strong>Resumo de Vendas:</strong><ul>";
  vendas.forEach(v => resultadoHTML += `<li>${v.nome}: ${v.vendidos} unid. - R$ ${v.totalVendido.toFixed(2)}</li>`);
  resultadoHTML += `</ul><p>Total Geral Vendido: R$ ${totalGeral.toFixed(2)}</p>`;
  document.getElementById("resultado").innerHTML = resultadoHTML;
}

// Nova contagem
function novaContagem() {
  toggleMenu();
  if (!confirm("Deseja criar uma nova contagem? Os dados atuais serão mantidos como estoque anterior e os dados persistentes serão resetados.")) {
    return;
  }

  salvarEstado();
  
  const tabela = document.getElementById("tabelaProdutos");
  const linhas = Array.from(tabela.querySelectorAll("tr"));
  tabela.innerHTML = "";

  linhas.forEach(linha => {
    const nome = linha.cells[0].firstChild.value;
    const unidadesPorCaixa = linha.cells[7].firstChild.value;
    const precoUnitario = linha.cells[8].firstChild.value;
    const estoqueAnteriorCx = linha.cells[5].firstChild.value || "";
    const estoqueAnteriorUn = linha.cells[6].firstChild.value || "";

    adicionarProduto({ 
      nome, 
      estoqueAnteriorCx, 
      estoqueAnteriorUn, 
      unidadesPorCaixa, 
      precoUnitario 
    });
  });

  // Atualiza a data para a data atual
  configurarDataAtual();
  
  // Salva os novos dados como persistentes
  salvarDadosPersistentes();
  
  calcular();
}

// Salva dados (mantido para compatibilidade)
function salvarDados() {
  salvarDadosAutomaticamente();
  alert("Dados salvos automaticamente!");
}

// Carrega dados salvos
function carregarDadosSelecionados() {
  salvarEstado();
  
  const data = document.getElementById("datasSalvas").value;
  if (!data) return;

  try {
    const dadosStr = localStorage.getItem("inventario-" + data);
    if (!dadosStr) return;
    
    const dados = JSON.parse(dadosStr);
    if (!Array.isArray(dados)) {
      throw new Error("Dados inválidos no localStorage");
    }
    
    document.getElementById("tabelaProdutos").innerHTML = "";
    dados.forEach(p => adicionarProduto(p));
    document.getElementById("dataContagem").value = data;
    
    // Atualiza os dados persistentes
    salvarDadosPersistentes();
    
    calcular();
  } catch (e) {
    console.error("Erro ao carregar dados:", e);
    alert("Erro ao carregar dados salvos. Os dados podem estar corrompidos.");
    localStorage.removeItem("inventario-" + data);
    atualizarSelectDatas();
  }
}

// Atualiza select de datas
function atualizarSelectDatas() {
  const select = document.getElementById("datasSalvas");
  select.innerHTML = '<option value="">Carregar outra data</option>';
  Object.keys(localStorage).forEach(k => {
    if (k.startsWith("inventario-")) {
      const data = k.replace("inventario-", "");
      const option = document.createElement("option");
      option.value = data;
      option.textContent = data;
      select.appendChild(option);
    }
  });
}

// Função para gerar relatório por período (estilo resumo de vendas)
function gerarRelatorioPeriodo() {
  const dataInicio = document.getElementById('dataInicioRelatorio').value;
  const dataFim = document.getElementById('dataFimRelatorio').value;
  
  if (!dataInicio || !dataFim) {
    alert('Por favor, selecione as datas de início e fim!');
    return;
  }
  
  const container = document.getElementById('relatorioResumoContainer');
  container.innerHTML = '';
  
  let totalUnidades = 0;
  let totalValor = 0;
  
  // Percorre todas as datas salvas no intervalo
  const datasSalvas = [];
  Object.keys(localStorage).forEach(k => {
    if (k.startsWith('inventario-')) {
      const data = k.replace('inventario-', '');
      if (data >= dataInicio && data <= dataFim) {
        datasSalvas.push(data);
      }
    }
  });
  
  if (datasSalvas.length === 0) {
    alert('Nenhum dado encontrado para o período selecionado!');
    return;
  }
  
  // Ordena as datas
  datasSalvas.sort();
  
  // Agrupa por produto para mostrar um resumo consolidado
  const relatorioPorProduto = {};
  
  datasSalvas.forEach(data => {
    const dados = JSON.parse(localStorage.getItem(`inventario-${data}`)) || [];
    
    dados.forEach(item => {
      const estCx = +item.estoqueAnteriorCx || 0;
      const estUn = +item.estoqueAnteriorUn || 0;
      const entCx = +item.entradasCx || 0;
      const entUn = +item.entradasUn || 0;
      const fimCx = +item.finalCx || 0;
      const fimUn = +item.finalUn || 0;
      const unPorCaixa = +item.unidadesPorCaixa || 1;
      const precoUn = +item.precoUnitario || 0;

      const totalInicial = (estCx + entCx) * unPorCaixa + estUn + entUn;
      const totalFinal = fimCx * unPorCaixa + fimUn;
      const vendidos = totalInicial - totalFinal;
      const totalVendido = vendidos * precoUn;
      
      if (vendidos > 0) {
        if (!relatorioPorProduto[item.nome]) {
          relatorioPorProduto[item.nome] = {
            unidades: 0,
            valor: 0
          };
        }
        
        relatorioPorProduto[item.nome].unidades += vendidos;
        relatorioPorProduto[item.nome].valor += totalVendido;
      }
    });
  });
  
  // Cria o cabeçalho do relatório
  const resumoHeader = document.createElement('div');
  resumoHeader.className = 'resumo-header';
  resumoHeader.innerHTML = `
    <h3>Relatório Resumido de Vendas</h3>
    <div class="resumo-periodo">Período: ${formatarData(dataInicio)} a ${formatarData(dataFim)}</div>
  `;
  container.appendChild(resumoHeader);
  
  // Cria a tabela de resumo
  const tabelaResumo = document.createElement('table');
  tabelaResumo.className = 'relatorio-resumo';
  
  // Cria o cabeçalho da tabela
  const thead = document.createElement('thead');
  thead.innerHTML = `
    <tr>
      <th>Produto</th>
      <th>Quantidade Vendida</th>
      <th>Valor Total (R$)</th>
    </tr>
  `;
  tabelaResumo.appendChild(thead);
  
  // Cria o corpo da tabela
  const tbody = document.createElement('tbody');
  
  // Preenche a tabela com os dados consolidados
  Object.keys(relatorioPorProduto).forEach(nome => {
    const item = relatorioPorProduto[nome];
    totalUnidades += item.unidades;
    totalValor += item.valor;
    
    const linha = document.createElement('tr');
    linha.innerHTML = `
      <td>${nome}</td>
      <td>${item.unidades} unid.</td>
      <td>${item.valor.toFixed(2)}</td>
    `;
    tbody.appendChild(linha);
  });
  
  // Adiciona linha de totais
  const linhaTotal = document.createElement('tr');
  linhaTotal.className = 'total-row';
  linhaTotal.innerHTML = `
    <td><strong>TOTAL</strong></td>
    <td><strong>${totalUnidades} unid.</strong></td>
    <td><strong>R$ ${totalValor.toFixed(2)}</strong></td>
  `;
  tbody.appendChild(linhaTotal);
  
  tabelaResumo.appendChild(tbody);
  container.appendChild(tabelaResumo);
  
  // Adiciona informações adicionais
  const infoAdicional = document.createElement('div');
  infoAdicional.style.marginTop = '15px';
  infoAdicional.style.fontSize = '13px';
  infoAdicional.style.color = '#666';
  infoAdicional.innerHTML = `
    <p><strong>Período analisado:</strong> ${datasSalvas.length} dia(s)</p>
    <p><strong>Total de produtos:</strong> ${Object.keys(relatorioPorProduto).length}</p>
    <p><strong>Gerado em:</strong> ${new Date().toLocaleString()}</p>
  `;
  container.appendChild(infoAdicional);
}

// Função para formatar data no formato DD/MM/AAAA
function formatarData(dataStr) {
  const [ano, mes, dia] = dataStr.split('-');
  return `${dia}/${mes}/${ano}`;
}

// Exporta relatório em formato TXT
function exportarRelatorioTXT() {
  const dataInicio = document.getElementById('dataInicioRelatorio').value;
  const dataFim = document.getElementById('dataFimRelatorio').value;
  
  if (!dataInicio || !dataFim) {
    alert('Por favor, selecione as datas de início e fim!');
    return;
  }
  
  // Cria o conteúdo do arquivo TXT
  let conteudoTXT = `Relatório Resumido de Vendas\n`;
  conteudoTXT += `Período: ${formatarData(dataInicio)} a ${formatarData(dataFim)}\n\n`;
  conteudoTXT += 'PRODUTO\tQUANTIDADE\tVALOR TOTAL (R$)\n';
  conteudoTXT += '----------------------------------------\n';
  
  // Percorre todas as linhas da tabela de resumo (exceto cabeçalho e total)
  const linhas = document.querySelectorAll('.relatorio-resumo tbody tr:not(.total-row)');
  linhas.forEach(linha => {
    const colunas = linha.querySelectorAll('td');
    const produto = colunas[0].textContent;
    const quantidade = colunas[1].textContent;
    const valor = colunas[2].textContent;
    
    conteudoTXT += `${produto}\t${quantidade}\t${valor}\n`;
  });
  
  conteudoTXT += '----------------------------------------\n';
  
  // Adiciona o total
  const linhaTotal = document.querySelector('.relatorio-resumo .total-row');
  if (linhaTotal) {
    const colunas = linhaTotal.querySelectorAll('td');
    conteudoTXT += `${colunas[0].textContent}\t${colunas[1].textContent}\t${colunas[2].textContent}\n`;
  }
  
  // Adiciona informações adicionais
  conteudoTXT += '\nINFORMAÇÕES ADICIONAIS:\n';
  const infos = document.querySelectorAll('#relatorioResumoContainer > div:last-child p');
  infos.forEach(info => {
    conteudoTXT += `${info.textContent}\n`;
  });
  
  // Cria um blob com o conteúdo
  const blob = new Blob([conteudoTXT], { type: 'text/plain' });
  
  // Cria um link para download
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `relatorio_resumido_vendas_${dataInicio}_a_${dataFim}.txt`;
  
  // Adiciona o link ao documento e simula o clique
  document.body.appendChild(link);
  link.click();
  
  // Remove o link após o download
  document.body.removeChild(link);
}

// Exporta relatório em formato PDF
function exportarRelatorioPDF() {
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  
  const dataInicio = document.getElementById('dataInicioRelatorio').value;
  const dataFim = document.getElementById('dataFimRelatorio').value;
  const periodo = `Período: ${formatarData(dataInicio)} a ${formatarData(dataFim)}`;
  
  // Título do relatório
  doc.setFontSize(16);
  doc.setTextColor(40);
  doc.text('Relatório Resumido de Vendas', 105, 15, { align: 'center' });
  
  // Período
  doc.setFontSize(12);
  doc.text(periodo, 105, 22, { align: 'center' });
  
  // Data de geração
  doc.setFontSize(10);
  doc.setTextColor(100);
  doc.text(`Gerado em: ${new Date().toLocaleString()}`, 105, 28, { align: 'center' });
  
  // Cabeçalho da tabela
  doc.setFontSize(12);
  doc.setTextColor(40);
  doc.setFillColor(59, 130, 246);
  doc.setTextColor(255, 255, 255);
  doc.rect(10, 35, 190, 8, 'F');
  doc.text('Produto', 15, 40);
  doc.text('Quantidade', 100, 40);
  doc.text('Valor Total (R$)', 160, 40);
  
  // Dados da tabela
  let y = 48;
  doc.setFontSize(10);
  doc.setTextColor(40);
  
  // Percorre todas as linhas da tabela de resumo (exceto cabeçalho e total)
  const linhas = document.querySelectorAll('.relatorio-resumo tbody tr:not(.total-row)');
  linhas.forEach(linha => {
    const colunas = linha.querySelectorAll('td');
    const produto = colunas[0].textContent;
    const quantidade = colunas[1].textContent;
    const valor = colunas[2].textContent;
    
    // Alterna cores das linhas para melhor legibilidade
    if (y % 2 === 0) {
      doc.setFillColor(243, 244, 246);
      doc.rect(10, y-4, 190, 6, 'F');
    }
    
    doc.text(produto, 15, y);
    doc.text(quantidade, 100, y);
    doc.text(valor, 160, y);
    
    y += 6;
  });
  
  // Linha de totais
  doc.setFontSize(11);
  doc.setFillColor(245, 158, 11);
  doc.setTextColor(255, 255, 255);
  doc.rect(10, y-4, 190, 8, 'F');
  
  const linhaTotal = document.querySelector('.relatorio-resumo .total-row');
  if (linhaTotal) {
    const colunas = linhaTotal.querySelectorAll('td');
    doc.text(colunas[0].textContent, 15, y+2);
    doc.text(colunas[1].textContent, 100, y+2);
    doc.text(colunas[2].textContent, 160, y+2);
  }
  
  // Informações adicionais
  y += 12;
  doc.setFontSize(10);
  doc.setTextColor(100);
  doc.text('Informações Adicionais:', 15, y);
  
  const infos = document.querySelectorAll('#relatorioResumoContainer > div:last-child p');
  infos.forEach(info => {
    y += 6;
    doc.text(info.textContent, 20, y);
  });
  
  // Salva o PDF
  doc.save(`relatorio_vendas_${dataInicio}_a_${dataFim}.pdf`);
}

// Compartilha relatório via WhatsApp
