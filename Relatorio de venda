<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Relatório de Vendas</title>
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <style>
    :root {
      --cor-primaria: #3b82f6;
      --cor-secundaria: #10b981;
      --cor-alerta: #ef4444;
      --cor-destaque: #f59e0b;
      --cor-fundo: #f3f4f6;
      --cor-texto: #1f2937;
      --cor-borda: #d1d5db;
      --cor-desfazer: #8b5cf6;
    }
    
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }
    
    body {
      background-color: var(--cor-fundo);
      margin: 0;
      padding: 8px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 14px;
      color: var(--cor-texto);
      line-height: 1.4;
      touch-action: manipulation;
    }
    
    .container {
      max-width: 100%;
      margin: 0 auto;
      background-color: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 12px;
      overflow: hidden;
    }
    
    h2 {
      font-size: 18px;
      font-weight: 700;
      text-align: center;
      margin: 0 0 12px 0;
      color: var(--cor-primaria);
    }
    
    .input-group {
      display: grid;
      grid-template-columns: 1fr;
      gap: 8px;
      margin-bottom: 12px;
    }
    
    @media (min-width: 400px) {
      .input-group {
        grid-template-columns: 1fr 2fr;
      }
    }
    
    label {
      font-weight: 600;
      font-size: 13px;
      display: block;
      margin-bottom: 4px;
    }
    
    input, select {
      width: 100%;
      padding: 8px;
      border: 1px solid var(--cor-borda);
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      background-color: white;
    }
    
    input:focus, select:focus {
      outline: none;
      border-color: var(--cor-primaria);
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }
    
    /* Menu oculto e botão de hambúrguer */
    .menu-toggle {
      position: fixed;
      top: 10px;
      right: 10px;
      width: 40px;
      height: 40px;
      background-color: var(--cor-primaria);
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      z-index: 1001;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
    
    .menu-toggle span {
      display: block;
      width: 20px;
      height: 2px;
      background-color: white;
      margin: 2px 0;
      transition: all 0.3s ease;
    }
    
    .hidden-menu {
      position: fixed;
      top: 0;
      right: -300px;
      width: 250px;
      height: 100%;
      background-color: white;
      z-index: 1000;
      transition: right 0.3s ease;
      padding: 60px 15px 15px;
      box-shadow: -2px 0 10px rgba(0,0,0,0.1);
      overflow-y: auto;
    }
    
    .hidden-menu.active {
      right: 0;
    }
    
    .menu-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.5);
      z-index: 999;
      display: none;
    }
    
    .menu-overlay.active {
      display: block;
    }
    
    .btn-group-menu {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    
    .btn-menu {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: none;
      font-weight: 600;
      font-size: 13px;
      cursor: pointer;
      transition: all 0.2s;
      text-align: left;
      display: flex;
      align-items: center;
    }
    
    .btn-menu i {
      margin-right: 8px;
      font-size: 16px;
    }
    
    .table-container {
      width: 100%;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      margin-bottom: 12px;
      border: 1px solid var(--cor-borda);
      border-radius: 8px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      min-width: 600px;
    }
    
    th, td {
      padding: 8px;
      text-align: center;
      border: 1px solid var(--cor-borda);
      font-size: 13px;
      font-weight: 600;
    }
    
    th {
      background-color: var(--cor-fundo);
      position: sticky;
      top: 0;
    }
    
    td:first-child, th:first-child {
      position: sticky;
      left: 0;
      background-color: white;
      text-align: left;
      min-width: 180px;
    }
    
    input[type="number"], input[type="text"] {
      width: 100%;
      padding: 8px;
      border: 1px solid var(--cor-borda);
      border-radius: 6px;
      text-align: center;
      font-weight: 600;
    }
    
    /* Ajustes para os campos de caixas, unidades e Un/Cx */
    input[type="number"].cx-un {
      max-width: 100px;
      margin: 0 auto;
      font-size: 14px;
    }
    
    /* Estilo para campos de preço */
    input[type="number"].preco {
      max-width: 120px;
    }
    
    /* Estilo para campo de produto */
    input[type="text"].produto {
      min-width: 180px;
      text-align: left;
      padding: 8px 12px;
    }
    
    #resultado {
      background-color: var(--cor-fundo);
      padding: 12px;
      border-radius: 8px;
      margin-bottom: 12px;
      font-size: 13px;
    }
    
    #resultado strong {
      display: block;
      margin-bottom: 6px;
      color: var(--cor-primaria);
    }
    
    #resultado ul {
      margin: 8px 0;
      padding-left: 20px;
    }
    
    #resultado p {
      margin-top: 8px;
      font-weight: 700;
    }
    
    /* Estilos do Modal */
    .modal {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.5);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    
    .modal-content {
      background-color: white;
      margin: 15% auto;
      padding: 20px;
      border-radius: 12px;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }
    
    /* Modal de tela inteira para relatórios - VERSÃO ATUALIZADA */
    .modal-fullscreen {
      display: none;
      position: fixed;
      z-index: 1050;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: white;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
      padding: 20px;
    }
    
    .modal-fullscreen-header {
      width: 100%;
      background-color: transparent;
      color: var(--cor-primaria);
      padding: 15px 0;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 1051;
    }
    
    .modal-fullscreen-title {
      font-size: 20px;
      font-weight: bold;
      color: var(--cor-primaria);
    }
    
    .close-fullscreen-modal {
      font-size: 24px;
      font-weight: bold;
      cursor: pointer;
      background: none;
      border: none;
      color: var(--cor-primaria);
    }
    
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }
    
    .modal-title {
      font-size: 18px;
      font-weight: 700;
      color: var(--cor-primaria);
    }
    
    .close-modal {
      font-size: 24px;
      font-weight: bold;
      color: var(--cor-texto);
      cursor: pointer;
    }
    
    .modal-body {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }
    
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px;
    }
    
    /* Melhorias para edição de cabeçalho */
    .editable-header {
      position: relative;
      cursor: pointer;
    }
    
    /* Efeito de toque em botões */
    button:active {
      opacity: 0.8;
    }
    
    /* Scroll suave para mobile */
    .table-container {
      scroll-behavior: smooth;
    }
    
    /* Efeito de delay na edição */
    .editable-header.editing {
      transition: all 0.3s ease;
      background-color: rgba(59, 130, 246, 0.1);
    }
    
    /* Estilos para o relatório detalhado */
    .relatorio-tabela {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    
    .relatorio-tabela th, .relatorio-tabela td {
      padding: 8px;
      border: 1px solid var(--cor-borda);
      text-align: center;
    }
    
    .relatorio-tabela th {
      background-color: var(--cor-fundo);
    }
    
    .relatorio-tabela tr:nth-child(even) {
      background-color: #f9f9f9;
    }
    
    /* Estilos VERTICAIS para o seletor de período no modal */
    .periodo-selector {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 15px;
    }
    
    .periodo-selector input {
      width: 100%;
      padding: 10px;
      border-radius: 8px;
      border: 1px solid var(--cor-borda);
    }
    
    .periodo-selector button {
      width: 100%;
      padding: 12px;
      border-radius: 8px;
      border: none;
      background-color: var(--cor-primaria);
      color: white;
      font-weight: 600;
      cursor: pointer;
    }
    
    /* Estilos para os totais no relatório */
    .relatorio-totais {
      font-weight: bold;
      background-color: var(--cor-fundo);
    }
    
    /* Barra de ferramentas no modal de relatório - VERSÃO VERTICAL */
    .relatorio-toolbar {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-bottom: 15px;
    }
    
    .relatorio-toolbar button {
      width: 100%;
      padding: 12px;
      border-radius: 6px;
      border: none;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }
    
    .btn-exportar {
      background-color: var(--cor-secundaria);
      color: white;
    }
    
    .btn-exportar-txt {
      background-color: var(--cor-destaque);
      color: white;
    }
    
    .btn-fechar {
      background-color: var(--cor-alerta);
      color: white;
    }
    
    /* Modal para contagem final - CORRIGIDO */
    .modal-contagem {
      display: none;
      position: fixed;
      z-index: 1100;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.5);
      justify-content: center;
      align-items: center;
    }

    .modal-contagem-content {
      background-color: white;
      padding: 20px;
      border-radius: 8px;
      width: 90%;
      max-width: 300px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .modal-contagem-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 15px;
    }

    .modal-contagem-title {
      font-size: 16px;
      font-weight: 700;
      color: var(--cor-primaria);
    }

    .modal-contagem-body {
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .modal-contagem-footer {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px;
    }
    
    /* Modal para Backup/Restore */
    .modal-backup {
      display: none;
      position: fixed;
      z-index: 1000;
      left: 0;
      top: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0,0,0,0.5);
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .modal-backup-content {
      background-color: white;
      margin: 15% auto;
      padding: 20px;
      border-radius: 12px;
      width: 90%;
      max-width: 500px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .backup-options {
      display: flex;
      flex-direction: column;
      gap: 15px;
      margin-top: 20px;
    }

    .backup-option {
      padding: 15px;
      border: 1px solid var(--cor-borda);
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .backup-option:hover {
      background-color: var(--cor-fundo);
    }

    .backup-option h3 {
      margin-top: 0;
      color: var(--cor-primaria);
    }

    .backup-option p {
      margin-bottom: 0;
      color: var(--cor-texto);
    }

    .textarea-backup {
      width: 100%;
      height: 200px;
      padding: 10px;
      border: 1px solid var(--cor-borda);
      border-radius: 8px;
      font-family: monospace;
      resize: vertical;
    }
    
    /* Estilos para o relatório resumido */
    .relatorio-resumo {
      width: 100%;
      border-collapse: collapse;
      margin-top: 10px;
    }
    
    .relatorio-resumo th, .relatorio-resumo td {
      padding: 10px;
      border: 1px solid var(--cor-borda);
      text-align: left;
    }
    
    .relatorio-resumo th {
      background-color: var(--cor-primaria);
      color: white;
    }
    
    .relatorio-resumo tr:nth-child(even) {
      background-color: var(--cor-fundo);
    }
    
    .relatorio-resumo .total-row {
      font-weight: bold;
      background-color: var(--cor-destaque);
      color: white;
    }
    
    .resumo-header {
      background-color: var(--cor-primaria);
      color: white;
      padding: 15px;
      border-radius: 8px 8px 0 0;
      margin-bottom: 0;
    }
    
    .resumo-periodo {
      font-size: 16px;
      font-weight: bold;
      margin-bottom: 15px;
      color: var(--cor-primaria);
    }
    
    /* Estilos responsivos para telas maiores */
    @media (min-width: 768px) {
      .periodo-selector {
        flex-direction: row;
        align-items: center;
      }
      
      .periodo-selector input {
        flex: 1;
      }
      
      .periodo-selector button {
        width: auto;
        min-width: 150px;
      }
      
      .relatorio-toolbar {
        flex-direction: row;
        flex-wrap: wrap;
      }
      
      .relatorio-toolbar button {
        width: auto;
        flex: 1;
        min-width: 150px;
      }
    }
  </style>
</head>
<body>
  <!-- Botão de menu hambúrguer -->
  <div class="menu-toggle" onclick="toggleMenu()">
    <span></span>
    <span></span>
    <span></span>
  </div>
  
  <!-- Menu oculto -->
  <div class="hidden-menu" id="hiddenMenu">
    <div class="btn-group-menu">
      <button onclick="abrirModalAdicionar()" class="btn-menu btn-primary">➕ Adicionar</button>
      <button onclick="calcular()" class="btn-menu btn-success">🟰 Calcular</button>
      <button onclick="desfazerAcao()" class="btn-menu btn-undo">↩️ Desfazer</button>
      <button onclick="novaContagem()" class="btn-menu btn-warning">🔄 Nova Contagem</button>
      <button onclick="abrirModalRelatorioPeriodo()" class="btn-menu btn-info">📅 Relatório por Período</button>
      <button onclick="abrirModalBackup()" class="btn-menu btn-primary">💾 Backup/Restore</button>
    </div>
  </div>
  
  <!-- Overlay do menu -->
  <div class="menu-overlay" id="menuOverlay"></div>
  
  <div class="container">
    <h2>Relatório de Vendas</h2>
    
    <div class="input-group">
      <div>
        <label for="dataContagem">Data:</label>
        <input type="date" id="dataContagem">
      </div>
      <div>
        <label for="datasSalvas">Datas Salvas:</label>
        <select id="datasSalvas" onchange="carregarDadosSelecionados()">
          <option value="">Carregar outra data</option>
        </select>
      </div>
    </div>
    
    <div class="table-container">
      <table id="tabelaInventario">
        <thead>
          <tr>
            <th class="editable-header" onclick="editarCabecalho(this)">Produto</th>
            <th class="editable-header" colspan="2" onclick="editarCabecalho(this)">Estoque Ant.</th>
            <th class="editable-header" colspan="2" onclick="editarCabecalho(this)">Entradas</th>
            <th class="editable-header" colspan="2" onclick="editarCabecalho(this)">Cont. Final</th>
            <th class="editable-header" onclick="editarCabecalho(this)">Un/Cx</th>
            <th class="editable-header" onclick="editarCabecalho(this)">Preço (R$)</th>
          </tr>
          <tr>
            <th></th>
            <th class="editable-header" onclick="editarCabecalho(this)">cx</th>
            <th class="editable-header" onclick="editarCabecalho(this)">un</th>
            <th class="editable-header" onclick="editarCabecalho(this)">cx</th>
            <th class="editable-header" onclick="editarCabecalho(this)">un</th>
            <th class="editable-header" onclick="editarCabecalho(this)">cx</th>
            <th class="editable-header" onclick="editarCabecalho(this)">un</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody id="tabelaProdutos"></tbody>
      </table>
    </div>
    
    <div id="resultado"></div>
  </div>

  <!-- Modal para Adicionar Produto -->
  <div id="modalAdicionar" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title">Adicionar Produto</h3>
        <span class="close-modal" onclick="fecharModal('modalAdicionar')">&times;</span>
      </div>
      <div class="modal-body">
        <div>
          <label for="modalNome">Produto:</label>
          <input type="text" id="modalNome" class="produto">
        </div>
        <div>
          <label>Estoque Anterior:</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <div>
              <label for="modalEstCx">cx</label>
              <input type="number" id="modalEstCx" class="cx-un" min="0" max="99999">
            </div>
            <div>
              <label for="modalEstUn">un</label>
              <input type="number" id="modalEstUn" class="cx-un" min="0" max="99999">
            </div>
          </div>
        </div>
        <div>
          <label>Entradas:</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <div>
              <label for="modalEntCx">cx</label>
              <input type="number" id="modalEntCx" class="cx-un" min="0" max="99999">
            </div>
            <div>
              <label for="modalEntUn">un</label>
              <input type="number" id="modalEntUn" class="cx-un" min="0" max="99999">
            </div>
          </div>
        </div>
        <div>
          <label>Contagem Final:</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <div>
              <label for="modalFimCx">cx</label>
              <input type="number" id="modalFimCx" class="cx-un" min="0" max="99999">
            </div>
            <div>
              <label for="modalFimUn">un</label>
              <input type="number" id="modalFimUn" class="cx-un" min="0" max="99999">
            </div>
          </div>
        </div>
        <div>
          <label for="modalUnCaixa">Unidades por Caixa:</label>
          <input type="number" id="modalUnCaixa" class="cx-un" min="1" value="1">
        </div>
        <div>
          <label for="modalPreco">Preço Unitário (R$):</label>
          <input type="number" id="modalPreco" class="preco" min="0" step="0.01" value="0">
        </div>
      </div>
      <div class="modal-footer">
        <button onclick="fecharModal('modalAdicionar')" class="btn-secondary">Cancelar</button>
        <button onclick="confirmarAdicao()" class="btn-primary">Confirmar</button>
      </div>
    </div>
  </div>

  <!-- Modal de tela inteira para Relatório por Período - VERSÃO ATUALIZADA -->
  <div id="modalRelatorioPeriodo" class="modal-fullscreen">
    <div class="modal-fullscreen-header">
      <h3 class="modal-fullscreen-title">Relatório</h3>
      <button class="close-fullscreen-modal" onclick="fecharModalRelatorioPeriodo()">&times;</button>
    </div>
    
    <div class="modal-fullscreen-body">
      <div class="periodo-selector">
        <input type="date" id="dataInicioRelatorio" placeholder="Data Início">
        <input type="date" id="dataFimRelatorio" placeholder="Data Fim">
        <button onclick="gerarRelatorioPeriodo()">Gerar Relatório</button>
      </div>
      
      <div class="relatorio-toolbar">
        <button class="btn-exportar" onclick="exportarRelatorioPDF()">
          <span>📊</span> Exportar PDF
        </button>
        <button class="btn-exportar-txt" onclick="exportarRelatorioTXT()">
          <span>📄</span> Exportar TXT
        </button>
        <button class="btn-exportar" onclick="compartilharWhatsApp()">
          <span>📱</span> Compartilhar no WhatsApp
        </button>
        <button class="btn-fechar" onclick="fecharModalRelatorioPeriodo()">
          <span>✕</span> Fechar
        </button>
      </div>
      
      <div id="relatorioResumoContainer">
        <!-- O conteúdo do relatório resumido será inserido aqui dinamicamente -->
      </div>
    </div>
  </div>

  <!-- Modal para Contagem Final -->
  <div id="modalContagemFinal" class="modal-contagem">
    <div class="modal-contagem-content">
      <div class="modal-contagem-header">
        <h3 class="modal-contagem-title">Contagem Final</h3>
        <span class="close-modal" onclick="fecharModal('modalContagemFinal')">&times;</span>
      </div>
      <div class="modal-contagem-body">
        <div>
          <label>Contagem Final:</label>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
            <div>
              <label for="modalContagemCx">cx</label>
              <input type="number" id="modalContagemCx" class="cx-un" min="0" max="99999">
            </div>
            <div>
