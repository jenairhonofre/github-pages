// Carrega dados do link compartilhado
function carregarDadosCompartilhados() {
  const urlParams = new URLSearchParams(window.location.search);
  const dadosCompartilhados = urlParams.get('data');
  
  if (dadosCompartilhados) {
    try {
      const produtos = JSON.parse(decodeURIComponent(dadosCompartilhados));
      document.getElementById('tabelaProdutos').innerHTML = '';
      produtos.forEach(p => adicionarProduto(p));
      salvarDadosPersistentes();
      calcular();
    } catch (e) {
      console.error('Erro ao carregar dados compartilhados:', e);
    }
  }
}

// Funções para Backup e Restore
function abrirModalBackup() {
  toggleMenu();
  document.getElementById('modalBackup').style.display = 'block';
  document.getElementById('backupText').style.display = 'none';
  document.getElementById('backupActions').style.display = 'none';
}

function gerarBackup() {
  // Coleta todos os dados do localStorage
  const dadosBackup = {};
  
  // Coleta todos os dados de inventário
  Object.keys(localStorage).forEach(key => {
    if (key.startsWith('inventario-') || key === 'infoFixas' || key === 'cabecalhos' || key === 'dadosPersistentes') {
      dadosBackup[key] = localStorage.getItem(key);
    }
  });
  
  // Cria um blob com os dados
  const blob = new Blob([JSON.stringify(dadosBackup, null, 2)], { type: 'application/json' });
  
  // Cria um link para download
  const link = document.createElement('a');
  link.href = URL.createObjectURL(blob);
  link.download = `backup_inventario_${new Date().toISOString().split('T')[0]}.json`;
  
  // Adiciona o link ao documento e simula o clique
  document.body.appendChild(link);
  link.click();
  
  // Remove o link após o download
  document.body.removeChild(link);
  
  fecharModal('modalBackup');
  alert('Backup gerado com sucesso!');
}

function restaurarBackup(input) {
  const file = input.files[0];
  if (!file) return;
  
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const dadosBackup = JSON.parse(e.target.result);
      
      if (!confirm('Tem certeza que deseja restaurar este backup? Todos os dados atuais serão substituídos.')) {
        return;
      }
      
      // Limpa os dados existentes
      Object.keys(localStorage).forEach(key => {
        if (key.startsWith('inventario-') || key === 'infoFixas' || key === 'cabecalhos' || key === 'dadosPersistentes') {
          localStorage.removeItem(key);
        }
      });
      
      // Restaura os dados do backup
      Object.keys(dadosBackup).forEach(key => {
        localStorage.setItem(key, dadosBackup[key]);
      });
      
      // Recarrega a página para aplicar as mudanças
      location.reload();
      
    } catch (e) {
      console.error('Erro ao restaurar backup:', e);
      alert('Erro ao restaurar backup. O arquivo pode estar corrompido.');
    }
  };
  reader.readAsText(file);
}

function copiarDadosBackup() {
  // Coleta todos os dados do localStorage
  const dadosBackup = {};
  
  // Coleta todos os dados de inventário
  Object.keys(localStorage).forEach(key => {
    if (key.startsWith('inventario-') || key === 'infoFixas' || key === 'cabecalhos' || key === 'dadosPersistentes') {
      dadosBackup[key] = localStorage.getItem(key);
    }
  });
  
  // Converte para string formatada
  const dadosTexto = JSON.stringify(dadosBackup, null, 2);
  
  // Cria um elemento textarea temporário
  const textarea = document.createElement('textarea');
  textarea.value = dadosTexto;
  document.body.appendChild(textarea);
  
  // Seleciona e copia o texto
  textarea.select();
  
  try {
    const copiado = document.execCommand('copy');
    if (copiado) {
      alert('Dados copiados para a área de transferência!');
      fecharModal('modalBackup');
    } else {
      throw new Error('Falha ao copiar');
    }
  } catch (err) {
    console.error('Erro ao copiar dados:', err);
    alert('Erro ao copiar dados para a área de transferência. Tente manualmente: Ctrl+C');
  } finally {
    document.body.removeChild(textarea);
  }
}

function restaurarDeTexto() {
  const texto = document.getElementById('backupText').value;
  if (!texto) {
    alert('Por favor, cole os dados de backup no campo de texto.');
    return;
  }
  
  try {
    const dadosBackup = JSON.parse(texto);
    
    if (!confirm('Tem certeza que deseja restaurar este backup? Todos os dados atuais serão substituídos.')) {
      return;
    }
    
    // Limpa os dados existentes
    Object.keys(localStorage).forEach(key => {
      if (key.startsWith('inventario-') || key === 'infoFixas' || key === 'cabecalhos' || key === 'dadosPersistentes') {
        localStorage.removeItem(key);
      }
    });
    
    // Restaura os dados do backup
    Object.keys(dadosBackup).forEach(key => {
      localStorage.setItem(key, dadosBackup[key]);
    });
    
    // Recarrega a página para aplicar as mudanças
    location.reload();
    
  } catch (e) {
    console.error('Erro ao restaurar backup:', e);
    alert('Erro ao restaurar backup. Os dados podem estar corrompidos ou no formato incorreto.');
  }
}

// Inicialização
window.onload = () => {
  // Carrega dados persistentes ao invés de configurar data atual diretamente
  carregarDadosPersistentes();
  
  atualizarSelectDatas();
  carregarDadosCompartilhados();
  
  // Carrega cabeçalhos salvos se existirem
  if (cabecalhosSalvos) {
    const ths = document.querySelectorAll('#tabelaInventario th');
    cabecalhosSalvos.forEach((texto, index) => {
      if (ths[index]) {
        ths[index].textContent = texto;
      }
    });
  }
  
  // Carrega informações fixas de produtos
  Object.keys(infoFixas).forEach(nome => {
    // Verifica se o produto já não foi carregado pelos dados persistentes
    const produtoExistente = Array.from(document.querySelectorAll("#tabelaProdutos tr")).some(linha => 
      linha.cells[0].firstChild.value === nome
    );
    
    if (!produtoExistente) {
      adicionarProduto({ nome, ...infoFixas[nome] });
    }
  });

  salvarEstado();
  calcular();

  // Configura arrastar e soltar para reordenar produtos
  new Sortable(document.getElementById("tabelaProdutos"), {
    animation: 150,
    ghostClass: "sortable-ghost",
    handle: "td:first-child",
    filter: "input",
    preventOnFilter: false,
    onEnd: () => {
      salvarEstado();
    }
  });
  
  // Configura o overlay para fechar o menu quando clicado
  document.getElementById("menuOverlay").addEventListener("click", function() {
    const menu = document.getElementById("hiddenMenu");
    if (menu.classList.contains("active")) {
      toggleMenu(); // Isso vai fechar o menu
    }
  });
  
  // Configura a exibição do campo de texto para restauração
  document.getElementById('backupText').addEventListener('focus', function() {
    document.getElementById('backupActions').style.display = 'block';
  });
  
  // Fecha modais quando clica fora
  window.onclick = function(event) {
    const modal = document.getElementById("modalAdicionar");
    const modalContagem = document.getElementById("modalContagemFinal");
    const modalRelatorio = document.getElementById("modalRelatorioPeriodo");
    const modalBackup = document.getElementById("modalBackup");
    
    if (event.target == modal) {
      fecharModal('modalAdicionar');
    }
    if (event.target == modalContagem) {
      fecharModal('modalContagemFinal');
    }
    if (event.target == modalRelatorio) {
      fecharModalRelatorioPeriodo();
    }
    if (event.target == modalBackup) {
      fecharModal('modalBackup');
    }
  };
};
