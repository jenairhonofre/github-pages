    const produto = colunas[0].textContent;
    const quantidade = colunas[1].textContent;
    const valor = colunas[2].textContent;
    
    mensagem += `- ${produto}: ${quantidade} (${valor})\n`;
  });
  
  // Adiciona o total
  const linhaTotal = document.querySelector('.relatorio-resumo .total-row');
  if (linhaTotal) {
    const colunas = linhaTotal.querySelectorAll('td');
    mensagem += `\n*TOTAL:* ${colunas[1].textContent} (${colunas[2].textContent})\n`;
