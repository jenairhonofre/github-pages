// Função para carregar dados persistentes
function carregarDadosPersistentes() {
  const dadosPersistentes = JSON.parse(localStorage.getItem("dadosPersistentes") || "null");
  if (dadosPersistentes) {
    // Restaura a data atual
    document.getElementById('dataContagem').value = dadosPersistentes.dataContagem || new Date().toISOString().split('T')[0];
    
    // Restaura os produtos
    document.getElementById("tabelaProdutos").innerHTML = "";
    if (dadosPersistentes.produtos && dadosPersistentes.produtos.length > 0) {
      dadosPersistentes.produtos.forEach(p => adicionarProduto(p));
    }
    
    // Calcula automaticamente
    calcular();
  } else {
    // Configura data atual se não houver dados persistentes
    configurarDataAtual();
  }
}

// Função para salvar dados persistentes
function salvarDadosPersistentes() {
  const produtos = [];
  document.querySelectorAll("#tabelaProdutos tr").forEach(linha => {
    const produto = {
      nome: linha.cells[0].firstChild.value,
      estoqueAnteriorCx: linha.cells[1].firstChild.value,
      estoqueAnteriorUn: linha.cells[2].firstChild.value,
      entradasCx: linha.cells[3].firstChild.value,
      entradasUn: linha.cells[4].firstChild.value,
      finalCx: linha.cells[5].firstChild.value,
      finalUn: linha.cells[6].firstChild.value,
      unidadesPorCaixa: linha.cells[7].firstChild.value,
      precoUnitario: linha.cells[8].firstChild.value
    };
    produtos.push(produto);
  });

  const dadosPersistentes = {
    dataContagem: document.getElementById('dataContagem').value,
    produtos: produtos,
    dataUltimaAtualizacao: new Date().toISOString()
  };

  localStorage.setItem("dadosPersistentes", JSON.stringify(dadosPersistentes));
}

// Funções para o menu oculto
function toggleMenu() {
  const menu = document.getElementById("hiddenMenu");
  const overlay = document.getElementById("menuOverlay");
  const toggle = document.querySelector(".menu-toggle");
  
  menu.classList.toggle("active");
  
  // Mostra ou esconde o overlay baseado no estado do menu
  overlay.classList.toggle("active");
  
  // Anima os spans do botão hambúrguer
  const spans = toggle.querySelectorAll("span");
  if (menu.classList.contains("active")) {
    spans[0].style.transform = "rotate(45deg) translate(5px, 5px)";
    spans[1].style.opacity = "0";
    spans[2].style.transform = "rotate(-45deg) translate(5px, -5px)";
  } else {
    spans[0].style.transform = "";
    spans[1].style.opacity = "";
    spans[2].style.transform = "";
  }
}

// Configura data atual ao carregar
function configurarDataAtual() {
  const hoje = new Date();
  const dataFormatada = hoje.toISOString().split('T')[0];
  document.getElementById('dataContagem').value = dataFormatada;
  document.getElementById('dataInicioRelatorio').value = dataFormatada;
  document.getElementById('dataFimRelatorio').value = dataFormatada;
}

